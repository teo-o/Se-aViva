<mxfile host="app.diagrams.net" agent="SeñaViva"><diagram name="SeñaViva — Arquitectura Entrega 2" id="senaviva-arquitectura"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sordo" value="&lt;b&gt;Usuario sordo&lt;/b&gt;&lt;hr&gt;Se comunica en LSC" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f3ead3;strokeColor=#1c1b2b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="190" height="70" as="geometry" /></mxCell><mxCell id="oyente" value="&lt;b&gt;Usuario oyente&lt;/b&gt;&lt;hr&gt;Habla o escribe en español" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f3ead3;strokeColor=#1c1b2b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="215" width="190" height="70" as="geometry" /></mxCell><mxCell id="interprete" value="&lt;b&gt;Intérprete / validador&lt;/b&gt;&lt;hr&gt;Valida el glosario (futuro)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f3ead3;strokeColor=#1c1b2b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="190" height="70" as="geometry" /></mxCell><mxCell id="admin" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;hr&gt;Gestiona usuarios y roles" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f3ead3;strokeColor=#1c1b2b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="190" height="70" as="geometry" /></mxCell><mxCell id="web" value="&lt;b&gt;Web SeñaViva&lt;/b&gt;&lt;hr&gt;Blazor Web App (.NET 10, SSR)&lt;br&gt;https://localhost:7200&lt;br&gt;• Inicio y registro&lt;br&gt;• Mi perfil (metadata Auth0)&lt;br&gt;• CRUD de usuarios&lt;br&gt;• CRUD de sesiones&lt;br&gt;• Cookie de sesión + tokens" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e3f1ee;strokeColor=#1f7a70;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="300" height="250" as="geometry" /></mxCell><mxCell id="swagger" value="&lt;b&gt;Swagger UI&lt;/b&gt;&lt;hr&gt;Pruebas de la API (OAuth2 PKCE / Bearer)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f3ead3;strokeColor=#1c1b2b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="405" width="300" height="70" as="geometry" /></mxCell><mxCell id="auth0" value="&lt;b&gt;Auth0 (tenant dev)&lt;/b&gt;&lt;hr&gt;• Universal Login (registro / login)&lt;br&gt;• Regular Web App «Seña ViVa»&lt;br&gt;• SPA «SeñaViva Swagger»&lt;br&gt;• API https://api.senaviva.local&lt;br&gt;• RBAC: Administrador, Usuario&lt;br&gt;• Post-Login Actions (rol, perfil)&lt;br&gt;• Form «Completar perfil» + Flow&lt;br&gt;   Update user → user_metadata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e7e2f2;strokeColor=#4b3a78;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="690" y="40" width="340" height="250" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;API SeñaViva&lt;/b&gt;&lt;hr&gt;ASP.NET Core Web API (.NET 10)&lt;br&gt;https://localhost:7168&lt;br&gt;Controllers → Services → DataContext&lt;br&gt;• Valida JWT (RS256, audience)&lt;br&gt;• Políticas por permiso&lt;br&gt;• /api/users, /api/users/me&lt;br&gt;• /api/conversation-sessions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fdf1d3;strokeColor=#b8860b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="690" y="330" width="340" height="200" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;SQL Server&lt;/b&gt;&lt;hr&gt;LocalDB · base SenaVivaDb&lt;br&gt;EF Core 10 · migración&lt;br&gt;InitialCreate&lt;br&gt;• Users&lt;br&gt;• ConversationSessions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f8e1da;strokeColor=#c2452b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="360" width="250" height="140" as="geometry" /></mxCell><mxCell id="future" value="&lt;b&gt;Motor de traducción&lt;/b&gt;&lt;hr&gt;(Entregas futuras)&lt;br&gt;Strategy: señas ↔ texto (LSC, ASL)&lt;br&gt;Adapter: MediaPipe, Whisper&lt;br&gt;Observer: subtítulos, avatar 3D,&lt;br&gt;repositorio de transcripción&lt;br&gt;Tablas: transcripcion, glosario_lsc" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#6b6578;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1110" y="40" width="250" height="250" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sordo" target="web"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="oyente" target="web"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="interprete" target="web"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="admin" target="swagger"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e4" value="OIDC · código" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="web" target="auth0"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e5" value="REST + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="330" /><mxPoint x="645" y="400" /></Array></mxGeometry></mxCell><mxCell id="e6" value="Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="swagger" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e7" value="JWKS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="api" target="auth0"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e8" value="EF Core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e9" value="futuro" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="future" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="320" /><mxPoint x="1000" y="320" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
